# Kopiere nach .env und passe an. .env wird NICHT committet.

# Code aus der Kanal-URL: https://whatsapp.com/channel/<DIESER_TEIL>
# Beispiel RV Waldmoessingen:
CHANNEL_INVITE=0029Vb82qq1G8l5DBLhALK0m

# Optional: direkte Kanal-ID statt Invite-Code (z. B. 1203630xxxxxxxxx@newsletter)
# CHANNEL_ID=

# Wie viele Beitraege maximal lesen
POST_LIMIT=20

# 0 = einmal laufen und beenden; >0 = alle N Sekunden wiederholen (Watch-Modus)
INTERVAL_SEC=0

# Ausgabe-Ordner (feed.json + media/) und Session-Ordner
# OUT_DIR=./out
# AUTH_DIR=./.wwebjs_auth

# headless=false zeigt das Browserfenster (nur zum Debuggen)
# HEADLESS=true
